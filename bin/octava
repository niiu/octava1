#!/usr/bin/env bash
# Octava — управление службой (systemd --user или фон без systemd)
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
ROOT="$(cd "${OCTAVA_HOME:-$BIN_DIR/..}" && pwd)"
UNIT_NAME="octava"
UNIT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${UNIT_NAME}.service"
RUN_DIR="$ROOT/.run"
PID_FILE="$RUN_DIR/octava.pid"
LOG_FILE="$RUN_DIR/octava.log"
SERVE="$ROOT/scripts/octava-serve.sh"

say() { printf '%s\n' "$*"; }
err() { printf 'octava: %s\n' "$*" >&2; }

need_root() {
  if [ ! -f "$ROOT/package.json" ]; then
    err "не вижу package.json в $ROOT"
    exit 1
  fi
}

use_systemd() {
  [ "${OCTAVA_INIT:-}" = "nohup" ] && return 1
  command -v systemctl >/dev/null 2>&1 || return 1
  [ -d /run/systemd/system ] || return 1
  systemctl --user show-environment >/dev/null 2>&1 || return 1
}

pid_alive() {
  local pid="${1:-}"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
  [ -f "$PID_FILE" ] || { echo ""; return; }
  tr -d ' \n' < "$PID_FILE"
}

write_unit() {
  local node_bin npm_dir
  node_bin="$(command -v node)"
  npm_dir="$(cd "$(dirname "$node_bin")" && pwd)"
  mkdir -p "$(dirname "$UNIT_FILE")"
  cat > "$UNIT_FILE" <<EOF
[Unit]
Description=Octava — загрузчик аудио YouTube
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$ROOT
Environment=PATH=$ROOT/node_modules/.bin:$ROOT/bin:$npm_dir:/usr/bin:/bin
Environment=YT_DLP_PATH=$ROOT/bin/yt-dlp
Environment=OCTAVA_HOME=$ROOT
Environment=OCTAVA_HOST=0.0.0.0
Environment=OCTAVA_PORT=8080
ExecStart=$SERVE
Restart=on-failure
RestartSec=4
TimeoutStopSec=20
KillSignal=SIGTERM
KillMode=mixed

[Install]
WantedBy=default.target
EOF
  chmod 644 "$UNIT_FILE"
}

link_cli() {
  local dest="${XDG_BIN_HOME:-$HOME/.local/bin}/octava"
  mkdir -p "$(dirname "$dest")"
  ln -sfn "$BIN_DIR/octava" "$dest"
  say "команда: $dest"
  case ":$PATH:" in
    *":$(dirname "$dest"):"*) ;;
    *) say "добавьте в PATH: export PATH=\"$(dirname "$dest"):\$PATH\"" ;;
  esac
}

cmd_setup() {
  need_root
  chmod +x "$SERVE" "$BIN_DIR/octava" 2>/dev/null || true
  link_cli
  if use_systemd; then
    write_unit
    systemctl --user daemon-reload
    say "unit: $UNIT_FILE"
  else
    mkdir -p "$RUN_DIR"
    say "systemd недоступен — будет фон через octava start (nohup)"
  fi
}

cmd_enable() {
  cmd_setup
  if use_systemd; then
    systemctl --user enable "$UNIT_NAME"
    if command -v loginctl >/dev/null 2>&1; then
      loginctl enable-linger "$USER" 2>/dev/null || true
    fi
    say "автозапуск включён (systemd --user)"
  else
    say "автозапуск systemd недоступен; запускайте: octava start"
  fi
  cmd_start
}

cmd_disable() {
  cmd_stop || true
  if use_systemd; then
    systemctl --user disable "$UNIT_NAME" 2>/dev/null || true
    say "автозапуск выключен"
  fi
}

cmd_start() {
  need_root
  chmod +x "$SERVE" "$BIN_DIR/octava" 2>/dev/null || true
  if use_systemd; then
    [ -f "$UNIT_FILE" ] || write_unit
    systemctl --user daemon-reload
    systemctl --user start "$UNIT_NAME"
    say "служба запущена: systemctl --user status $UNIT_NAME"
    return 0
  fi
  local pid
  pid="$(read_pid)"
  if pid_alive "$pid"; then
    say "уже работает (pid $pid)"
    return 0
  fi
  mkdir -p "$RUN_DIR"
  nohup "$SERVE" >>"$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 0.4
  pid="$(read_pid)"
  if pid_alive "$pid"; then
    say "запущена в фоне (pid $pid)"
    say "логи: $LOG_FILE"
  else
    err "не удалось запустить, смотрите $LOG_FILE"
    return 1
  fi
}

cmd_stop() {
  if use_systemd && [ -f "$UNIT_FILE" ]; then
    systemctl --user stop "$UNIT_NAME" 2>/dev/null || true
    say "служба остановлена"
    return 0
  fi
  local pid
  pid="$(read_pid)"
  if pid_alive "$pid"; then
    kill "$pid" 2>/dev/null || true
    sleep 0.3
    pid_alive "$pid" && kill -9 "$pid" 2>/dev/null || true
    say "остановлена (pid $pid)"
  else
    say "уже остановлена"
  fi
  rm -f "$PID_FILE"
}

cmd_restart() {
  cmd_stop || true
  cmd_start
}

cmd_status() {
  if use_systemd && [ -f "$UNIT_FILE" ]; then
    systemctl --user status "$UNIT_NAME" --no-pager || true
    return 0
  fi
  local pid
  pid="$(read_pid)"
  if pid_alive "$pid"; then
    say "active (nohup) pid $pid"
    say "log $LOG_FILE"
  else
    say "inactive"
    return 3
  fi
}

cmd_logs() {
  if use_systemd && [ -f "$UNIT_FILE" ]; then
    exec journalctl --user -u "$UNIT_NAME" -n 80 --no-pager -f
  fi
  mkdir -p "$RUN_DIR"
  touch "$LOG_FILE"
  exec tail -n 80 -f "$LOG_FILE"
}

cmd_help() {
  cat <<EOF
Octava — служба загрузчика YouTube

  octava start      запустить в фоне
  octava stop       остановить
  octava restart    перезапустить
  octava status     состояние
  octava logs       журнал
  octava enable     systemd --user + автозапуск + старт
  octava disable    выключить автозапуск и остановить
  octava setup      только unit и команда в ~/.local/bin

Ubuntu:
  systemctl --user start octava
  systemctl --user stop octava
  systemctl --user enable --now octava
  journalctl --user -u octava -f

После установки слушает порт 8080. OCTAVA_PORT / OCTAVA_HOST можно задать в unit.
EOF
}

cmd="${1:-help}"
case "$cmd" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  enable) cmd_enable ;;
  disable) cmd_disable ;;
  setup) cmd_setup ;;
  help|-h|--help) cmd_help ;;
  *)
    err "неизвестная команда: $cmd"
    cmd_help
    exit 2
    ;;
esac
